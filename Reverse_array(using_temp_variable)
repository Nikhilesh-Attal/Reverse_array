//Reversing an array using third variable

#include<stdio.h>

int main(){
    int a[10]={1,4,7,2,5,8,3,6,9,0};
    int i;
    printf("Entered array is :\t");
    for(i=0;i<10;i++){
        printf("%d\t",a[i]);
    }
    printf("\n");
     int start = 0, end = 9, temp;
    while(end>start){
        temp = a[start];
        a[start] = a[end];
        a[end] = temp;
        end--;
        start++;
    }

    printf("Array after reverse :\t");
    for(i=0;i<10;i++){
        printf("%d\t",a[i]);
    }
    return 0;
}
